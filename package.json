{
  "name": "sudoku-and-dragons",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/store-sourcemaps.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:integration": "node scripts/test-integration.ts",
    "typecheck": "tsc -p . && tsc -p src/core && tsc -p tsconfig.e2e.json",
    "sim:hp": "node scripts/sim-enemy-hp.ts",
    "sim:timer": "node scripts/sim-timer.ts",
    "sim:campaign": "node scripts/sim-campaign.ts",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android",
    "icons": "node scripts/render-icons.ts",
    "dragons": "node scripts/preview-dragons.ts",
    "function:bundle": "node scripts/bundle-function.ts && node scripts/bundle-function.ts daily",
    "sim:duel": "node scripts/sim-duel.ts",
    "test:server": "node scripts/test-duel-server.ts",
    "test:matchmaking": "node scripts/test-matchmaking.ts",
    "diagnostics:resolve": "node scripts/resolve-diagnostic.ts",
    "perf:startup": "node scripts/measure-startup.ts",
    "deploy:web": "npm run build && wrangler pages deploy dist --project-name sudoku-dragons --branch main"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@fontsource/baloo-2": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "gsap": "^3.15.0",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@jridgewell/trace-mapping": "0.3.31",
    "@playwright/test": "1.64.1",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "supabase": "2.122.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
