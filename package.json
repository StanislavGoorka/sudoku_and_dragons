{
  "name": "sudoku-and-dragons",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p . && tsc -p src/core",
    "sim:hp": "node scripts/sim-enemy-hp.ts",
    "sim:timer": "node scripts/sim-timer.ts",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android",
    "icons": "node scripts/render-icons.ts",
    "function:bundle": "node scripts/bundle-function.ts",
    "sim:duel": "node scripts/sim-duel.ts",
    "test:server": "node scripts/test-duel-server.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@supabase/supabase-js": "^2.118.0",
    "gsap": "^3.15.0",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
